---
import '../styles/global.css'; // [At] sin esto, Tailwind no se carga en esta parte del sitio

export interface Props {
  title: string;

}

const { title } = Astro.props; //end point de cual componente se renderiza (bio, teaching ...)

---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title> <!-- -->
  </head>
  <body class="min-h-screen bg-white text-slate-800"> 
      <slot name="sidebar" /> <!-- [At] -->
      <main class="w-full lg:ml-64 p-6 lg:p-10"> <!-- [tw] -->
        <slot /> <!-- [At] slot por defecto: aquí entra Bio/Teaching/Research -->
      </main>
   </body>
</html>