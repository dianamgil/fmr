---
import '../styles/global.css'; // [At] sin esto, Tailwind no se carga en esta parte del sitio
import Footer from '../components/Footer.astro';
import { getUser } from '../lib/getUser';

// ...Props igual que ahora
const user = await getUser(); // Astro la cachea: no se carga dos veces aunque la página ya la llame

export interface Props {
  title: string;
}

const { title } = Astro.props; //end point de cual componente se renderiza (bio, teaching ...)

---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title> <!-- -->
  </head>
  <body class="min-h-screen bg-white text-slate-800"> 
      <slot name="sidebar" /> <!-- [At] -->
      <main class=" md:ml-70 p-6 md:p-10 md:pl-16 lg:pl-20"> <!--  -->
        <slot /> <!-- [At] slot por defecto: aquí entra Bio/Teaching/Research -->
      </main>
      <Footer/>
   </body>
</html>