---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getUser } from '../../lib/getUser';
import Bio from '../../components/Bio.astro';

const user = await getUser(); //espera los datos del profesor 
---


<!-- contenido de componente BIO.astro, que contiene la info de la sección "longbio del json"-->
<BaseLayout title={`${user.name} . Bio`}>
  <Sidebar user={user} slot = "sidebar" />
  <Bio user={user} />   
</BaseLayout> 