---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPublications } from '../../lib/getPublications';
import { getUser } from '../../lib/getUser';


import Publications from '../../components/Publications.astro';

const publications = await getPublications(); //espera los datos del profesor 
const user = await getUser();
---


<!-- <Publications user="{user}"/>contenido de componente BIO.astro, que contiene la info de la sección "longbio del json"  -->
<BaseLayout title={`${user.name}. Publications`}>
    <Sidebar user={user} slot="sidebar"/>
    <Publications  publications={publications} />
</BaseLayout>