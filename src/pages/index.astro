---

import { getUser } from '../lib/getUser';
import ProfileHeader from '../components/ProfileHeader.astro';
import SocialIcons from '../components/SocialIcons.astro';
import LinkButton from '../components/LinkButton.astro';
import '../styles/global.css';

const user = await getUser(); // esto permite que si user no existe, la página falle en lugar de renderizarse con datos indefinidos

---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> 
  </head>
  <body class="bg-slate-50 text-slate-800 flex flex-col items-center min-h-screen p-6">
    <main class="w-full max-w-md flex flex-col items-center mt-8">
      <ProfileHeader user={user} />
      <SocialIcons socials={user.socials} />
      <section class="w-full flex flex-col gap-3 mt-4">
        {user.links.map((link) => (
          <LinkButton title={link.title} url={link.url} />
        ))}
      </section>
    </main>
  </body>
</html>