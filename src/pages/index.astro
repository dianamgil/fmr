---

import { getUser } from '../lib/getUser';
import ProfileHeader from '../components/ProfileHeader.astro';
import  SociaLinksIcons  from '../components/SociaLinksIcons.astro';
import LinkButton from '../components/LinkButton.astro';
import Dropdown from '../components/Dropdown.astro';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';

const user = await getUser(); // esto permite que si user no existe, la página falle en lugar de renderizarse con datos indefinidos

const year = new Date().getFullYear();

---
<!-- SocialIcons socials={user.links} -->
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{user.name}</title>
  </head>
  <body class="bg-linear-to-r from-[#B0E0E6] to-[#E4F5F7] text-slate-800 flex flex-col items-center min-h-screen p-6"> <!-- degradado horizontal de fondo -->
    <main class="w-full max-w-md flex flex-col items-center mt-8">

      <ProfileHeader user={user} />
      <SociaLinksIcons socials={user.links} ids={['in_link', 'facebook_link', 'email_link']} />

      <section class="w-full flex flex-col gap-3 m-6">
        <LinkButton  socials={user.links}  />
              <Dropdown label="About Me" 
              links={[
                { href: '/aboutme/bio', text: 'Acerca de mí' },
                { href: '/aboutme/teaching', text: 'Docencia' },
                { href: '/aboutme/publications', text: 'Publicaciones' },
                { href: '/aboutme/research', text: 'Investigación' },]}
               />
      </section>
      

    </main>
  
      <footer class="mt-auto pt-10">
      <span class="inline-flex items-center justify-center gap-1 text-sm text-slate-400">
        <Icon name="mdi:copyright" class="w-4 h-4" aria-label="Copyright" />
        {year} Fernando Martín Rivera.
      </span>
      </footer>
    
  </body>
</html> 