---
import type {CollectionEntry} from 'astro:content'; // importa  la colección 'user'
import {Icon} from 'astro-icon/components'; // importa el componente Icon de astro-icon  


type Social = CollectionEntry<'user'>['data']['socials'][number] // define el tipo Social como un objeto con propiedades name, url e icon

export interface Props {
    socials : Social[]; // recibe un array de objetos Social, cada uno con propiedades name, url e icon
}

//VARIABLES 
    const { socials }= Astro.props; // Declara la variable socials y le asigna el valor (atributos) de las props recibidas
    const localIcons = ['researchgate', 'google-scholar']; // iconos propios en src/icons/ NO DEL PAQUETE MDI
//ICONOS



---

<div class="flex gap-3 justify-center mt-4"> <!-- responsive: iconos con tamaño fijo (40px), suficientemente pequeños para no necesitar breakpoints propios -->
  {socials.map((social) => {
    const isEmail = social.icon === 'email';
    const href = isEmail
      ? social.url.startsWith('mailto:')
        ? social.url
        : `mailto:${social.url}`
      : social.url;
    return (
      <a
        href={href}
        target={isEmail ? undefined : '_blank'}
        rel={isEmail ? undefined : 'noopener noreferrer'}
        aria-label={social.name}
        class="w-10 h-10 flex items-center justify-center rounded-full bg-white text-slate-700 font-semibold shadow-sm hover:shadow-md hover:scale-[1.05] transition-all"
      >
        
       <Icon name={ 
        localIcons.includes(social.icon ?? '') ? social.icon : `mdi:${social.icon}`} class="w-5 h-5" />
      </a>
    );
  })}
</div>