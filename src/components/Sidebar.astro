---

import type {CollectionEntry} from 'astro:content'; //para tipar el array de links que se usaran
import  SociaLinksIcons  from '../components/SociaLinksIcons.astro';
import { Icon } from 'astro-icon/components';

export interface Props{
    user: CollectionEntry<'user'>['data']; //tipado de la data del usuario{ label: 'INICIO', href: '/' }, //lleva a pagina inicial
}

const {user} = Astro.props; 

const nav = [
  
  { label: 'ACERCA DE MÍ', href: 'bio' },
  { label: 'DOCENCIA', href: 'teaching' },
  { label: 'INVESTIGACIÓN', href: 'research' },
  { label: 'PUBLICACIONES', href: 'publications' },
];
---


<!-- botónHamburguesa visible solo en pantallas pequeñas <md:hidden > para desplegar sideBar y a la derecha para no tapar backButton -->
<button
  id="sidebar-toggle"
  type="button"
  class="md:hidden fixed top-4 right-4 z-50 flex items-center justify-center
         w-10 h-10 rounded-full bg-slate-800 text-white shadow-md"
          aria-controls="mySidenav"          
          aria-expanded="false"
          aria-label="Abrir menú">
  <Icon name="mdi:menu" class="w-6 h-6" />
</button>

  

<!-- responsive: fondo oscuro solo en móvil; oculto hasta que el JS abra el menú -->
<div id="sidebar-overlay" 
    class="hidden md:hidden fixed inset-0 z-30 bg-black/40">
</div>

<aside id="mySidenav"
     class="fixed inset-y-0 left-0  z-40 w-75
     -translate-x-full transition-transform duration-300 ease-out
      md:translate-x-0 
     bg-linear-to-r from-[#B0E0E6] to-[#E4F5F7] 
     overflow-y-auto px-8 py-10 lg:p-8 flex flex-col gap-6"> <!-- estilo global del sidebar --> <!-- md:translate-x-0  responsive: en móvil fuera de pantalla hasta que el JS lo abra; desde lg siempre visible -->

<!-- backButton<span>Volver al inicio</span> -->
  <!-- responsive: pill compacta en móvil; mismo tamaño desde md, alineada a la izquierda -->
  <a
    href="/"
    class="self-start inline-flex items-center gap-1 py-2 px-2 rounded-full
           bg-white text-slate-600 font-semibold shadow-sm
           hover:scale-[1.05] hover:shadow-lg transition-transform"
  >
    <Icon name="mdi:arrow-left-thick" class="w-6 h-6 shrink-0" aria-hidden="true" />
  </a>

 <!-- bloque 1 perfil  -->
   <section class="flex items-start gap-5 pb-2 border-b-3 border-white/40">
    <div class="flex flex-col gap-3">
        <h2 class="text-2xl font-bold">Fernando Martin, PhD</h2>
        <!-- <p class="text-gray-600"> Sistemática del Movimiento{user.role}</p> -->
        <img class="w-40 h-40 object-cover shrink-0" src={user.avatar}/>
        

      <div class="flex flex-col gap-1 mt-8">
        <p class="text-gray-600">Profesor Titular</p>
        <p class="text-gray-400">
          <a href={user.universityLink} target="_blank" class="text-slate-600 hover:text-white">
            {user.university}
          </a></p>
          <h4 class="text-gray-400">46010 Valencia, España</h4>
        
      </div>
        <p ></p>
    </div>  
  </section> 

         <!-- bloque 2  Navegación -->
    <nav class="flex flex-col gap-2 pb-6 border-b-3 border-white/40">
         {nav.map((item) => (
            <a href={item.href} class="text-slate-600 font-semibold hover:text-white">{item.label}</a>
            ))}
    </nav>
<!-- bloque 3   rrss -->
         <div class="flex flex-col gap-2  items-start" >
            <SociaLinksIcons socials={user.links} ids={[ 'rg_link', 'email_link','gs_link', 'cv_link','orcid_link']}
             showLabels/>

         </div>



         <!-- script para manejo de menu en pantallas pequeñas -->
<script>
  // recoger los 3 elementos 
  const btn = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('mySidenav');
  const overlay = document.getElementById('sidebar-overlay');
 
  //comprobacion 
  if (btn && sidebar && overlay) {
 
    // Única función que cambia el estado: open = true abre, false cierra
    const setOpen = (open: boolean) => {
      // toggle(clase, condición): pone la clase si la condición es true, la quita si es false
      sidebar.classList.toggle('-translate-x-full', !open); // sin esta clase el sidebar entra en pantalla
      overlay.classList.toggle('hidden', !open);            // muestra u oculta el fondo oscuro
      btn.setAttribute('aria-expanded', String(open));       // guarda el estado para el lector de pantalla y para el clic
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
 
    // Clic en el botón: si estaba cerrado ('false') lo abre, si estaba abierto lo cierra
    btn.addEventListener('click', () =>
      setOpen(btn.getAttribute('aria-expanded') !== 'true'));
 
    // Clic en el fondo oscuro: cierra
    overlay.addEventListener('click', () => setOpen(false));
 
    // Tecla Escape: cierra
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
 
    // Clic en cualquier enlace del sidebar: cierra SIDEBAR antes de navegar..OJO VER SI SE ACTIVA MAS ADELANTE
    //sidebar.querySelectorAll('a').forEach((a) =>
      //a.addEventListener('click', () => setOpen(false)));
  }
</script>
      
</aside>