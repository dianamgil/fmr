---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { boldSegments } from '../lib/boldSegments';

export interface Props {
  user: Pick<CollectionEntry<'user'>['data'], 'longBio' | 'skills'>; // tipado desde Zod: solo la bio larga
}

const { user } = Astro.props;
---


<!-- responsive: título más grande desde md; ancho de lectura limitado con max-w-3xl  <!-- seguridad (XSS): {paragraph} se escapa automáticamente (< y > se muestran como texto, no se ejecutan).-->-->
<section class="w-full max-w-3xl">
  <h1 class="text-2xl md:text-3xl font-bold mb-4 text-justify">Sobre mi</h1>

  <div class="flex flex-col gap-4 text-slate-700 leading-relaxed">
   {user.longBio.map((paragraph) => (
  <p>
    {boldSegments(paragraph).map((s) =>
      s.bold ? <strong class="font-semibold text-slate-800">{s.text}</strong> : s.text // <strong>: énfasis semántico, no solo visual
    )}
  </p>
))}
  </div>

  {user.skills.length > 0 && ( // sin skills no se pinta la sección
    <section class="mt-10">
          <h2 class="text-xl md:text-2xl font-semibold mb-4">Skills</h2>
          <!-- responsive: 1 columna en móvil; desde sm llena de arriba abajo, 6 filas por columna y abre otra columna -->
          <ul class="grid gap-y-3 sm:grid-flow-col sm:grid-rows-[repeat(6,auto)]  sm:justify-start sm:gap-x-12"> {/* 6 filas por columna */}
            {user.skills.map((skill) => (
              <li class="flex items-center gap-2 text-slate-700">
                <Icon name="mdi:check-decagram" class="size-4 shrink-0 text-sky-700" aria-hidden="true" /> 
                <span>{skill}</span>
              </li>
            ))}
          </ul>
    </section>
  )}
</section>