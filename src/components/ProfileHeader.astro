---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  user: Pick<CollectionEntry<'user'>['data'], 'name' | 'role' | 'university' | 'avatar' | 'bio'>;
}
const { user } = Astro.props;
---


<header class="flex flex-col items-center text-center gap-1 py-10 px-4">
  <img
    src={user.avatar}
    alt={user.name}
    width="96"
    height="96"
    loading="eager"
    fetchpriority="high"
    class="w-24 h-24 rounded-full border-4 border-white shadow-sm object-cover"
  /> <!--loading y fetchpriority= fuerzan carga inmediata y prioritaria del avatar  -->


    <h1 class="text-xl md:text-2xl lg:text-3xl font-bold mt-4">{user.name}</h1> <!-- responsive -->
  <p class="text-sm md:text-base text-slate-500 font-medium">{user.role}</p> <!-- responsive -->
  <p class="text-xs md:text-sm text-slate-400 mt-1">{user.university}</p> <!-- responsive -->
  <p class="text-sm md:text-base
   text-slate-600 mt-4 px-2 max-w-md lg:max-w-lg">{user.bio}</p> <!-- responsive: el ancho máximo del bio crece en desktop -->
</header>