---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  user: Pick<CollectionEntry<'user'>['data'], 'name' | 'role' | 'university' | 'avatar' | 'bio'>;
}
const { user } = Astro.props;
---

<header class="flex flex-col items-center text-center gap-1 py-6 px-4 md:py-8 lg:py-10"> <!-- responsive: más padding vertical en pantallas grandes -->
  <img
    src={user.avatar}
    alt={user.name}
    width="128"
    height="128"
    loading="eager"
    fetchpriority="high"
    class="w-16 h-16 md:w-32 md:h-32 lg:w-48 lg:h-48 rounded-full border-4 border-white shadow-md object-cover"
  /> <!-- responsive: avatar escala 64px -> 128px -> 192px. loading/fetchpriority fuerzan carga inmediata (LCP) -->

  <h1 class="text-xl md:text-2xl lg:text-3xl font-bold mt-4">{user.name}</h1> <!-- responsive -->
  <p class="text-sm md:text-base text-slate-500 font-medium">{user.role}</p> <!-- responsive -->
  <p class="text-xs md:text-sm text-slate-400 mt-1">{user.university}</p> <!-- responsive -->
  <p class="text-sm md:text-base text-slate-600 mt-4 px-2 max-w-md lg:max-w-lg">{user.bio}</p> <!-- responsive: el ancho máximo del bio crece en desktop -->
</header>
