---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  user: Pick<CollectionEntry<'user'>['data'], 'name' | 'role' | 'university' | 'avatar' | 'bio' | 'universityLink'>; // solo los campos que se usan en este componente
}
const { user } = Astro.props;
---


<header class="flex flex-col items-center text-center gap-1 py-10 px-4">
  <img
    src={user.avatar}
    alt={user.name}
    width="96"
    height="96"
    loading="eager"
    fetchpriority="high"
    class="w-28 h-28 md:w-32 md:h-32 rounded-2xl border-4 border-white shadow-sm object-contain bg-white"
  /> <!--loading y fetchpriority= fuerzan carga inmediata y prioritaria del avatar  -->


    <h1 class="text-xl md:text-2xl lg:text-3xl font-bold mt-4">{user.name}</h1> 
  <p class="text-sm md:text-base text-slate-500 font-medium">{user.role}</p> 
  <a href={user.universityLink} target="_blank" class="text-slate-600 hover:text-white">
            {user.university}
  </a>
  <p class="text-sm md:text-base
   text-slate-600 mt-4 px-2 max-w-md lg:max-w-lg">{user.bio}</p> <!-- responsive: el ancho máximo del bio crece en desktop -->
</header>