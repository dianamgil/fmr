---

import type { Project } from '../lib/getProjects';
export interface Props { projects: Project[] }
const { projects } = Astro.props;
import { Icon } from 'astro-icon/components';

---
<section class="w-full max-w-3xl">
  <h1 class="text-2xl md:text-3xl font-bold mb-4">PROYECTOS DE INVESTIGACIÓN</h1>
  <p class="text-slate-700 leading-relaxed mb-10">  Lista de Proyectos de I+D+i obtenidos en convocatorias públicas competitivas.</p>

 <ol
  class="relative space-y-8 before:absolute before:-ms-px before:h-full before:w-0.5 before:rounded-full before:bg-gray-200">
     {projects.map((project) => (
      <li class="relative -ms-1.5 flex items-start gap-4">
        <span class="size-3 shrink-0 rounded-full bg-blue-600"></span>
        <div>
           <time class="text-xs/none font-medium text-gray-700">{project.start} - {project.end ?? 'present'}</time>

          <!-- responsive: título algo mayor desde md -->
          <h2 class="text-lg font-bold text-gray-900">{project.title}</h2>
          <p class="mt-0.5 text-sm text-gray-700">
            {project.role}{project.participants && ` · ${project.participants} participantes`}
          </p>
          <p class="text-sm text-slate-400">{project.funder} · {project.code}</p>
        </div>
      </li>
    ))}
</ol>
</section>