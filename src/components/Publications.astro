---

import type { Publication } from '../lib/getPublications';
import { Icon } from 'astro-icon/components';
export interface Props { publications: Publication[] }
const { publications } = Astro.props;

---


<section class="w-full max-w-3xl">
  <h1 class="text-2xl md:text-3xl font-bold mb-4">PUBLICACIONES</h1>
  <p class="text-slate-700 leading-relaxed mb-10">Aquí puedes encontrar mis publicaciones.  </p>

   {publications.length === 0 ? (
    <p class="py-8 text-center text-sm text-gray-500 md:text-base">Todavía no hay publicaciones disponibles.</p>
  ) : (
   //<!-- responsive: una columna; más separación entre publicaciones desde md -->
    <ol class="space-y-6 md:space-y-8">
      {publications.map((pub) => (
        <li>
          <!-- responsive: título algo mayor desde md -->
          <h2 class="text-base font-bold leading-snug text-slate-900 md:text-lg">{pub.title}</h2>
         

          <!-- responsive: los autores hacen salto de línea solos en móvil -->
          <p class="mt-3 text-sm text-slate-600 md:text-base">
            {pub.authors.map((a, i) => (<>{i > 0 && ', '}{a.isMe ? <b>{a.name}</b> : a.name}</>))}
          </p>

          <p class="text-sm text-slate-400">{pub.journal}, {pub.date}</p>

          {pub.href && (
            <a href={pub.href} target="_blank" rel="noopener noreferrer"
               aria-label={`${pub.doi ? 'DOI' : 'Artículo'}: ${pub.title}`}
               class="mt-3 inline-flex items-center gap-1.5 rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">
              {pub.doi ? 'DOI' : 'Ver artículo'}
              <Icon name="mdi:open-in-new" class="h-4 w-4" aria-hidden="true" />
            </a>
          )}
        </li>
      ))}
    </ol>
  )}
</section>